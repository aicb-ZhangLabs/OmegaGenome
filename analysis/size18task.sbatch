#!/bin/bash
# Student-SIZE scaling sweep across the 17 non-splice_sites_all tasks (NT-2.5B teacher) => turns
# Fig 6B into an 18-task-mean size-scaling curve (splice_sites_all already swept across sizes).
# 6 sizes x 17 tasks x 3 seeds = 306 runs. model_size includes extra_large_fix (FIXED uncapped-
# dilation 0.8M variant; the buggy `extra_large` is NEVER submitted).
#
# ONE array task == ONE run. Reads its spec line from size18task_specs.txt (generated by
# analysis/size18task_specs.py) and trains it INLINE on the allocated GPU via
# `python -m src.train.distill <spec>` (mode=run => in-process, NOT a nested submit). Env mirrors
# method3_18task.sbatch / rerun_below_baseline.sbatch EXACTLY (HF cache on SSD, portable venv,
# triton cache).
#
# QUEUED-AFTER-METHOD3: the dependency below holds the whole array until the running method-
# ablation array (251923, loom_method3-18task) finishes, so it queues meanwhile and never
# competes for laniakea GPUs. %8 + laniakea nodelist respects the fair-share cap (laniakea<=8).
#
# TEACHER CACHE: the data split is built from dataset_config.random_state (fixed 42) and does NOT
# depend on model_size (student-only), so the on-disk NT teacher cache is valid+reused for EVERY
# (task,size,seed). Logit-only tasks (weight_mse=0) skip the 3B teacher load; weight_mse>0 tasks
# forward the teacher for features exactly like method3/vanilla (size/seed-independent).
#
# DO NOT bare-submit. The 1-epoch extra_large_fix DRY-RUN (see below) validated the FIXED config
# trains + cache hit. Submit with:
#   sbatch analysis/size18task.sbatch                    # all 306, 8 concurrent, after 251923
#
#SBATCH --job-name=loom_size18task
#SBATCH --array=0-305%17
# (dependency removed — method3 essentially done; start immediately)
#SBATCH --nodes=1
#SBATCH --partition=zhanglab.p
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=5
#SBATCH --mem=64G
#SBATCH --requeue
#SBATCH --time=12:00:00
#SBATCH --output=slurm-%x-%A_%a.out

set -euo pipefail
REPO=${OG_ROOT:-$PWD}
cd "$REPO"
source slurm/env_setup.sh

# ---- HF cache on the node-aware SSD (identical to method3_18task.sbatch / rerun_below_baseline) ----
for _b in ${OG_SCRATCH:-$PWD/output} ${OG_SCRATCH:-$PWD/output}; do [ -d "$_b" ] && { _SSD="$_b"; break; }; done
[ -n "${_SSD:-}" ] && export HF_OVERRIDE="$_SSD/hf_cache_shared"
if [ -n "${HF_OVERRIDE:-}" ]; then
  export HF_HOME="$HF_OVERRIDE" HF_HUB_CACHE="$HF_OVERRIDE/hub" HUGGINGFACE_HUB_CACHE="$HF_OVERRIDE/hub" \
         HF_DATASETS_CACHE="$HF_OVERRIDE/datasets" TRANSFORMERS_CACHE="$HF_OVERRIDE/hub" HF_ASSETS_CACHE="$HF_OVERRIDE/assets"
  mkdir -p "$HF_OVERRIDE/hub" "$HF_OVERRIDE/datasets" "$HF_OVERRIDE/assets"
fi
export HF_TOKEN="$(cat ${HF_TOKEN_FILE})"
export WANDB_INIT_TIMEOUT=300 WANDB_MODE=offline
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export TRITON_CACHE_DIR="/tmp/${USER}_triton_cache"; mkdir -p "$TRITON_CACHE_DIR"
PY="$REPO/.venv_carbon_portable/bin/python"

SPECS="$REPO/analysis/size18task_specs.txt"
[ -f "$SPECS" ] || { echo "missing $SPECS -- run analysis/size18task_specs.py first"; exit 1; }

# SLURM_ARRAY_TASK_ID is 0-based; specs file is 1-based.
LINE_NO=$(( ${SLURM_ARRAY_TASK_ID:-0} + 1 ))
SPEC=$(sed -n "${LINE_NO}p" "$SPECS")
[ -n "$SPEC" ] || { echo "no spec on line $LINE_NO of $SPECS"; exit 1; }

echo "=== [array ${SLURM_ARRAY_TASK_ID}] line ${LINE_NO}: $SPEC ==="
# shellcheck disable=SC2086
"$PY" -m src.train.distill $SPEC
echo "=== done line ${LINE_NO} ==="

# ---------------------------------------------------------------------------
# DRY-RUN (validate the extra_large_fix pipeline before the 306-run sweep). Runs
# extra_large_fix / H3K9ac / seed 0 for ONE epoch: cache hit (mse=0 logit-only) -> student
# train -> best-val ckpt -> test eval. Deliberately the 0.8M FIX config, to confirm it does NOT
# collapse (buggy extra_large gave ~0.25). Cheap; put on ANY free node (NOT dependent):
#
#   srun --partition=zhanglab.p --gres=gpu:1 --cpus-per-task=5 --mem=64G --time=1:00:00 \
#     bash -c 'source slurm/env_setup.sh; \
#       .venv_carbon_portable/bin/python -m src.train.distill nt_vanilla --task-names H3K9ac \
#       --student-config.model-size extra_large_fix --distillation-config.weight-ce 0.5 \
#       --distillation-config.weight-kl 1 --distillation-config.weight-mse 0 \
#       --distillation-config.temperature 2 --trainer-config.epochs 1 \
#       --trainer-config.eval-every-n-epochs 1 --trainer-config.early-stop-patience 0 \
#       --trainer-config.output-dir ${OG_SCRATCH:-$PWD/output}/size18task_DRYRUN/H3K9ac/extra_large_fix \
#       --random-state 0 --slurm-config.mode run'
# ---------------------------------------------------------------------------
