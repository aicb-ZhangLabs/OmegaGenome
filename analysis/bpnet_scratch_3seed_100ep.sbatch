#!/bin/bash
# 3-seed FROM-SCRATCH BPNet baseline sweep: 18 tasks x seeds {0,1,2} = 54 runs.
# ONE array task == ONE run. Reads its spec line from bpnet_scratch_3seed_specs.txt (generated by
# analysis/bpnet_scratch_3seed_specs.py) and trains it INLINE on the allocated GPU via
# `python -m src.train.distill <spec>` (mode=run => in-process, NOT a nested submit).
#
# These re-run the single-seed reported BPNet baseline (plot_repo formal_5teacher_benchmark.csv,
# Family=BPNet/Type=Baseline, Std=0.0) with 3 seeds so the baseline gets error bars matching the
# distilled students. Each run is PURE-SUPERVISED (weight_kl=0, weight_mse=0 => NO teacher term in
# the student loss) on the `original` full-RF BPNet student at the students' recipe (200ep / bs16 /
# lr1e-4 / max_len1000, AdamW). The Carbon LoRA teacher is only a checkpoint/eval reference: its
# teacher_evaluation.json caches are warm for all 18 tasks, so no 3B teacher forward is needed for
# the student's training (the pure-CE student loss is teacher-independent by construction).
#
# Env mirrors slurm/carbon_distill.sbatch / rerun_below_baseline.sbatch EXACTLY (HF cache on SSD,
# portable venv, triton cache) so data/tokenizer/teacher-cache loading is identical to the students.
#
# DO NOT bare-submit. First run the 1-epoch DRY-RUN (see DRY-RUN below) to validate the pipeline.
# Then, respecting the fair-share caps (laniakea<=8), submit e.g.:
#   sbatch analysis/bpnet_scratch_3seed.sbatch                  # all 54, 8 concurrent
#   sbatch --array=0-2 analysis/bpnet_scratch_3seed.sbatch      # just task0 (3 seeds) smoke
#
#SBATCH --job-name=loom_bpnet-scratch-3seed-100ep
#SBATCH --array=0-53%8
#SBATCH --nodelist=laniakea
#SBATCH --partition=zhanglab.p
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=5
#SBATCH --mem=24G
#SBATCH --requeue
#SBATCH --time=3:00:00
#SBATCH --output=slurm-%x-%A_%a.out

set -euo pipefail
REPO=${OG_ROOT:-$PWD}
cd "$REPO"
source slurm/env_setup.sh

# ---- HF cache on the node-aware SSD (identical to carbon_distill.sbatch / rerun_below_baseline) ----
for _b in ${OG_SCRATCH:-$PWD/output} ${OG_SCRATCH:-$PWD/output}; do [ -d "$_b" ] && { _SSD="$_b"; break; }; done
[ -n "${_SSD:-}" ] && export HF_OVERRIDE="$_SSD/hf_cache_shared"
if [ -n "${HF_OVERRIDE:-}" ]; then
  export HF_HOME="$HF_OVERRIDE" HF_HUB_CACHE="$HF_OVERRIDE/hub" HUGGINGFACE_HUB_CACHE="$HF_OVERRIDE/hub" \
         HF_DATASETS_CACHE="$HF_OVERRIDE/datasets" TRANSFORMERS_CACHE="$HF_OVERRIDE/hub" HF_ASSETS_CACHE="$HF_OVERRIDE/assets"
  mkdir -p "$HF_OVERRIDE/hub" "$HF_OVERRIDE/datasets" "$HF_OVERRIDE/assets"
fi
export HF_TOKEN="$(cat ${HF_TOKEN_FILE})"
export WANDB_INIT_TIMEOUT=300 WANDB_MODE=offline
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export TRITON_CACHE_DIR="/tmp/${USER}_triton_cache"; mkdir -p "$TRITON_CACHE_DIR"
PY="$REPO/.venv_carbon_portable/bin/python"

SPECS="$REPO/analysis/bpnet_scratch_3seed_100ep_specs.txt"
[ -f "$SPECS" ] || { echo "missing $SPECS -- run analysis/bpnet_scratch_3seed_specs.py first"; exit 1; }

# SLURM_ARRAY_TASK_ID is 0-based; specs file is 1-based.
LINE_NO=$(( ${SLURM_ARRAY_TASK_ID:-0} + 1 ))
SPEC=$(sed -n "${LINE_NO}p" "$SPECS")
[ -n "$SPEC" ] || { echo "no spec on line $LINE_NO of $SPECS"; exit 1; }

echo "=== [array ${SLURM_ARRAY_TASK_ID}] line ${LINE_NO}: $SPEC ==="
# shellcheck disable=SC2086
"$PY" -m src.train.distill $SPEC
echo "=== done line ${LINE_NO} ==="

# ---------------------------------------------------------------------------
# DRY-RUN (validate the full from-scratch pipeline before the 54-run sweep). Runs ONE task for ONE
# epoch, exercising: teacher-ckpt find + warm teacher-eval cache read -> student build (original
# BPNet) -> PURE-CE student train (1 epoch, NO teacher forward) -> best-val ckpt -> test eval ->
# final_summary.json. Uses a DISTINCT _DRYRUN output-dir so it never pollutes the real sweep dir.
#
#   srun --partition=zhanglab.p --nodelist=laniakea --gres=gpu:1 --cpus-per-task=5 --mem=24G --time=0:30:00 \
#     bash -c 'cd ${OG_ROOT:-$PWD}; source slurm/env_setup.sh; \
#       for _b in ${OG_SCRATCH:-$PWD/output} ${OG_SCRATCH:-$PWD/output}; do [ -d "$_b" ] && { _SSD="$_b"; break; }; done; \
#       export HF_OVERRIDE="$_SSD/hf_cache_shared" HF_HOME="$_SSD/hf_cache_shared" \
#         HF_HUB_CACHE="$_SSD/hf_cache_shared/hub" HUGGINGFACE_HUB_CACHE="$_SSD/hf_cache_shared/hub" \
#         HF_DATASETS_CACHE="$_SSD/hf_cache_shared/datasets" TRANSFORMERS_CACHE="$_SSD/hf_cache_shared/hub"; \
#       export HF_TOKEN="$(cat ${HF_TOKEN_FILE})" WANDB_MODE=offline; \
#       .venv_carbon_portable/bin/python -m src.train.distill carbon-raw-original --task-names H3K4me3 \
#         --distillation-config.weight-ce 0.5 --distillation-config.weight-kl 0 --distillation-config.weight-mse 0 \
#         --trainer-config.epochs 1 --trainer-config.eval-every-n-epochs 1 --trainer-config.early-stop-patience 0 \
#         --trainer-config.output-dir ${OG_SCRATCH:-$PWD/output}/bpnet_scratch_3seed_DRYRUN/bpnet \
#         --random-state 0 --slurm-config.mode run; \
#       find ${OG_SCRATCH:-$PWD/output}/bpnet_scratch_3seed_DRYRUN/bpnet -name final_summary.json -exec cat {} \;'
# ---------------------------------------------------------------------------
