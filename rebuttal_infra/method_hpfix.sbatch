#!/bin/bash
# TARGETED HP-fix rerun of the 9 DIST/LS classification cells that COLLAPSED in the method3 sweep
# (they reused OmegaGenome's vanilla HP; diagnosis: weight_kl=1.0 traps a constant-prediction basin,
# weight_kl<=0.5 escapes). ONE known-good config for all 9 -- weight_kl=0.5, temperature=4,
# weight_ce=1.0 (the config that let splice_sites_donors reach 0.95). 9 cells x 1 config x 3 seeds
# = 27 runs. Best-val ckpt per cell; pick best per cell by 3-seed mean afterward.
#
# ONE array task == ONE run. Reads its spec line from method_hpfix_specs.txt (generated by
# rebuttal_infra/method_hpfix_specs.py) and trains it INLINE on the allocated GPU via
# `python -m src.train.distill <spec>` (mode=run => in-process, NOT a nested submit). Env mirrors
# size18task.sbatch / method3_18task.sbatch EXACTLY (HF cache on SSD, portable venv, triton cache).
#
# MULTI-NODE (correct pattern, from the FIXED size18task.sbatch): --nodes=1 + --partition=zhanglab.p
# and NO --nodelist -> the array floats across all 3 GPU nodes. Runs CO-EQUAL with the size sweep:
# --array=0-26%6 caps it at 6 of the ~17 shared GPUs so size keeps ~11; NO --nice (normal priority)
# so both progress at once, still within the fair-share caps (GPU-limited to ~17 total).
#
# TEACHER CACHE: NT-2.5B teacher logits/features cache reused (verified present for all 9 tasks);
# weight_mse=0 => logit-only, features not required.
#
# DO NOT bare-submit. Run the 1-epoch DRY-RUN first (see DRY-RUN below). Then submit with:
#   sbatch rebuttal_infra/method_hpfix.sbatch                       # all 27, 6 concurrent, normal prio
#
#SBATCH --job-name=loom_method-hpfix
#SBATCH --array=0-26%6
#SBATCH --nodes=1
#SBATCH --partition=zhanglab.p
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=5
#SBATCH --mem=64G
#SBATCH --requeue
#SBATCH --time=12:00:00
#SBATCH --output=slurm-%x-%A_%a.out

set -euo pipefail
REPO=/home/pengchx3/text-dna/OmegaGenome_Revise_202606/code_carbon
cd "$REPO"
source slurm/env_setup.sh

# ---- HF cache on the node-aware SSD (identical to size18task.sbatch / method3_18task.sbatch) ----
for _b in /tmp/galaxy_srv_disk00/pengchx3 /srv/disk00/sshfs/pengchx3; do [ -d "$_b" ] && { _SSD="$_b"; break; }; done
[ -n "${_SSD:-}" ] && export HF_OVERRIDE="$_SSD/hf_cache_shared"
if [ -n "${HF_OVERRIDE:-}" ]; then
  export HF_HOME="$HF_OVERRIDE" HF_HUB_CACHE="$HF_OVERRIDE/hub" HUGGINGFACE_HUB_CACHE="$HF_OVERRIDE/hub" \
         HF_DATASETS_CACHE="$HF_OVERRIDE/datasets" TRANSFORMERS_CACHE="$HF_OVERRIDE/hub" HF_ASSETS_CACHE="$HF_OVERRIDE/assets"
  mkdir -p "$HF_OVERRIDE/hub" "$HF_OVERRIDE/datasets" "$HF_OVERRIDE/assets"
fi
export HF_TOKEN="$(cat /home/pengchx3/text-dna/huggingface-token-0616.txt)"
export WANDB_INIT_TIMEOUT=300 WANDB_MODE=offline
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export TRITON_CACHE_DIR="/tmp/${USER}_triton_cache"; mkdir -p "$TRITON_CACHE_DIR"
PY="$REPO/.venv_carbon_portable/bin/python"

SPECS="$REPO/rebuttal_infra/method_hpfix_specs.txt"
[ -f "$SPECS" ] || { echo "missing $SPECS -- run rebuttal_infra/method_hpfix_specs.py first"; exit 1; }

# SLURM_ARRAY_TASK_ID is 0-based; specs file is 1-based.
LINE_NO=$(( ${SLURM_ARRAY_TASK_ID:-0} + 1 ))
SPEC=$(sed -n "${LINE_NO}p" "$SPECS")
[ -n "$SPEC" ] || { echo "no spec on line $LINE_NO of $SPECS"; exit 1; }

echo "=== [array ${SLURM_ARRAY_TASK_ID}] line ${LINE_NO}: $SPEC ==="
# shellcheck disable=SC2086
"$PY" -m src.train.distill $SPEC
echo "=== done line ${LINE_NO} ==="

# ---------------------------------------------------------------------------
# DRY-RUN (validate the fix pipeline before the 27-run array). Runs dist / splice_sites_acceptors /
# seed 0 for ONE epoch: teacher cache hit -> student train -> best-val ckpt -> test eval. Confirms
# it is LEARNING (not stuck at 0.0 collapse). Cheap; put on ANY free node (NOT dependent):
#
#   srun --partition=zhanglab.p --gres=gpu:1 --cpus-per-task=5 --mem=64G --time=1:00:00 \
#     bash -c 'source slurm/env_setup.sh; \
#       .venv_carbon_portable/bin/python -m src.train.distill nt_vanilla --task-names splice_sites_acceptors \
#       --distillation-config.distill-method dist --distillation-config.weight-ce 1.0 \
#       --distillation-config.weight-kl 0.5 --distillation-config.weight-mse 0 \
#       --distillation-config.temperature 4 --trainer-config.epochs 1 \
#       --trainer-config.eval-every-n-epochs 1 --trainer-config.early-stop-patience 0 \
#       --trainer-config.output-dir /tmp/galaxy_srv_disk00/pengchx3/method_hpfix_DRYRUN/dist/splice_sites_acceptors/seed0 \
#       --random-state 0 --slurm-config.mode run'
# ---------------------------------------------------------------------------
