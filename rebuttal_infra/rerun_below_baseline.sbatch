#!/bin/bash
# Rerun the below-baseline / DNABERT-2-completion sweep: 27 (teacher,task) cells x 3 seeds = 81 runs.
# ONE array task == ONE run. Reads its spec line from rerun_below_baseline_specs.txt (generated by
# rebuttal_infra/rerun_below_baseline_specs.py) and trains it INLINE on the allocated GPU via
# `python -m src.train.distill <spec>` (mode=run => in-process, NOT a nested submit).
#
# Mirrors slurm/carbon_distill.sbatch's env exactly (HF cache on SSD, portable venv, triton cache)
# so every teacher (NT-2.5B / Caduceus / Enformer / DNABERT-2 / Carbon-3B) loads the same way the
# reported 3-seed did -- the ONLY differences vs the reported runs are: epochs 200 (DNABERT-2 was
# 100), early-stop-patience 0 (explicit no-early-stop), and a fresh output-dir. Best-val-MCC
# checkpoint selection is already the trainer default (src/trainer/distill_trainer.py:443-458).
#
# DO NOT bare-submit. First run the 1-epoch dry-run (see DRY-RUN below) to validate the pipeline.
# Then, respecting the fair-share caps (laniakea<=8), submit with e.g.:
#   sbatch rebuttal_infra/rerun_below_baseline.sbatch                 # all 81, 8 concurrent
#   sbatch --array=0-53%8 rebuttal_infra/rerun_below_baseline.sbatch  # just the 54 DNABERT-2 runs
#   sbatch --array=54-80%6 rebuttal_infra/rerun_below_baseline.sbatch # just the 27 non-DNABERT runs
#
#SBATCH --job-name=loom_rerun-belowbase-distill
#SBATCH --array=0-80%8
#SBATCH --nodelist=laniakea
#SBATCH --partition=zhanglab.p
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=5
#SBATCH --mem=24G
#SBATCH --requeue
#SBATCH --time=6:00:00
#SBATCH --output=slurm-%x-%A_%a.out

set -euo pipefail
REPO=/home/pengchx3/text-dna/OmegaGenome_Revise_202606/code_carbon
cd "$REPO"
source slurm/env_setup.sh

# ---- HF cache on the node-aware SSD (identical to carbon_distill.sbatch) ----
for _b in /tmp/galaxy_srv_disk00/pengchx3 /srv/disk00/sshfs/pengchx3; do [ -d "$_b" ] && { _SSD="$_b"; break; }; done
[ -n "${_SSD:-}" ] && export HF_OVERRIDE="$_SSD/hf_cache_shared"
if [ -n "${HF_OVERRIDE:-}" ]; then
  export HF_HOME="$HF_OVERRIDE" HF_HUB_CACHE="$HF_OVERRIDE/hub" HUGGINGFACE_HUB_CACHE="$HF_OVERRIDE/hub" \
         HF_DATASETS_CACHE="$HF_OVERRIDE/datasets" TRANSFORMERS_CACHE="$HF_OVERRIDE/hub" HF_ASSETS_CACHE="$HF_OVERRIDE/assets"
  mkdir -p "$HF_OVERRIDE/hub" "$HF_OVERRIDE/datasets" "$HF_OVERRIDE/assets"
fi
export HF_TOKEN="$(cat /home/pengchx3/text-dna/huggingface-token-0616.txt)"
export WANDB_INIT_TIMEOUT=300 WANDB_MODE=offline
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export TRITON_CACHE_DIR="/tmp/${USER}_triton_cache"; mkdir -p "$TRITON_CACHE_DIR"
PY="$REPO/.venv_carbon_portable/bin/python"

SPECS="$REPO/rebuttal_infra/rerun_below_baseline_specs.txt"
[ -f "$SPECS" ] || { echo "missing $SPECS -- run rebuttal_infra/rerun_below_baseline_specs.py first"; exit 1; }

# SLURM_ARRAY_TASK_ID is 0-based; specs file is 1-based.
LINE_NO=$(( ${SLURM_ARRAY_TASK_ID:-0} + 1 ))
SPEC=$(sed -n "${LINE_NO}p" "$SPECS")
[ -n "$SPEC" ] || { echo "no spec on line $LINE_NO of $SPECS"; exit 1; }

echo "=== [array ${SLURM_ARRAY_TASK_ID}] line ${LINE_NO}: $SPEC ==="
# shellcheck disable=SC2086
"$PY" -m src.train.distill $SPEC
echo "=== done line ${LINE_NO} ==="

# ---------------------------------------------------------------------------
# DRY-RUN (validate the full pipeline before the 81-run sweep). Runs ONE cell for ONE epoch,
# exercising teacher-load -> teacher-logit precompute -> student train -> best-val ckpt save ->
# test eval -> final_summary.json. Uses DNABERT-2 (small teacher) so it is cheap even on CPU.
#
#   # short GPU slice (recommended -- 1 epoch, ~1-2 min):
#   srun --partition=zhanglab.p --nodelist=laniakea --gres=gpu:1 --cpus-per-task=5 --mem=24G --time=0:20:00 \
#     bash -c 'source slurm/env_setup.sh; \
#       .venv_carbon_portable/bin/python -m src.train.distill dna_bert_v2 --task-names H3K9ac \
#       --distillation-config.weight-ce 0.5 --distillation-config.weight-kl 1 --distillation-config.weight-mse 2 \
#       --distillation-config.temperature 4 --trainer-config.epochs 1 --trainer-config.eval-every-n-epochs 1 \
#       --trainer-config.early-stop-patience 0 \
#       --trainer-config.output-dir /tmp/galaxy_srv_disk00/pengchx3/rerun_below_baseline_DRYRUN/dnabert2 \
#       --random-state 0 --slurm-config.mode run'
#
#   # CPU-only variant (no GPU needed; add  --trainer-config.device cpu  to the same command).
# ---------------------------------------------------------------------------
