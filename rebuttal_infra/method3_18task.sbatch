#!/bin/bash
# 3-KD-method x 18-task x 3-seed distillation sweep (NT-2.5B teacher) => REAL per-method 18-task means
# for DKD / DIST / Logit-Standardization (replaces a fabricated rebuttal column).
#
# ONE array task == ONE run. Reads its spec line from method3_18task_specs.txt (generated by
# rebuttal_infra/method3_18task_specs.py) and trains it INLINE on the allocated GPU via
# `python -m src.train.distill <spec>` (mode=run => in-process, NOT a nested submit). Env mirrors
# slurm/carbon_distill.sbatch / rerun_below_baseline.sbatch / bpnet_scratch_3seed.sbatch EXACTLY
# (HF cache on SSD, portable venv, triton cache).
#
# QUEUED-AFTER-BPNET: the dependency below holds the whole array until BOTH BPNet arrays
# (251790 + 251889) finish, so it queues meanwhile and never competes for laniakea GPUs.
# %8 + laniakea nodelist respects the fair-share cap (laniakea<=8).
#
# TEACHER-CACHE WARNING: the NT teacher logits/features cache validates ONLY for random_state=42;
# seeds 0/1/2 MISS it, so every run loads + forwards the NT-2.5B teacher (~expensive). Consider
# pre-building per-(task,seed) caches first (see report) before submitting the full 162.
#
# DO NOT bare-submit. Run the 1-epoch DRY-RUN first (see DRY-RUN below). Then submit with e.g.:
#   sbatch rebuttal_infra/method3_18task.sbatch                    # all 162, 8 concurrent, after BPNet
#   sbatch --array=0-17%8 rebuttal_infra/method3_18task.sbatch     # just dkd tasks, seeds interleaved
#
#SBATCH --job-name=loom_method3-18task
#SBATCH --array=0-161%8
#SBATCH --dependency=afterany:251790:251889
#SBATCH --nodelist=laniakea
#SBATCH --partition=zhanglab.p
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=5
#SBATCH --mem=64G
#SBATCH --requeue
#SBATCH --time=12:00:00
#SBATCH --output=slurm-%x-%A_%a.out

set -euo pipefail
REPO=/home/pengchx3/text-dna/OmegaGenome_Revise_202606/code_carbon
cd "$REPO"
source slurm/env_setup.sh

# ---- HF cache on the node-aware SSD (identical to carbon_distill.sbatch / rerun_below_baseline) ----
for _b in /tmp/galaxy_srv_disk00/pengchx3 /srv/disk00/sshfs/pengchx3; do [ -d "$_b" ] && { _SSD="$_b"; break; }; done
[ -n "${_SSD:-}" ] && export HF_OVERRIDE="$_SSD/hf_cache_shared"
if [ -n "${HF_OVERRIDE:-}" ]; then
  export HF_HOME="$HF_OVERRIDE" HF_HUB_CACHE="$HF_OVERRIDE/hub" HUGGINGFACE_HUB_CACHE="$HF_OVERRIDE/hub" \
         HF_DATASETS_CACHE="$HF_OVERRIDE/datasets" TRANSFORMERS_CACHE="$HF_OVERRIDE/hub" HF_ASSETS_CACHE="$HF_OVERRIDE/assets"
  mkdir -p "$HF_OVERRIDE/hub" "$HF_OVERRIDE/datasets" "$HF_OVERRIDE/assets"
fi
export HF_TOKEN="$(cat /home/pengchx3/text-dna/huggingface-token-0616.txt)"
export WANDB_INIT_TIMEOUT=300 WANDB_MODE=offline
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export TRITON_CACHE_DIR="/tmp/${USER}_triton_cache"; mkdir -p "$TRITON_CACHE_DIR"
PY="$REPO/.venv_carbon_portable/bin/python"

SPECS="$REPO/rebuttal_infra/method3_18task_specs.txt"
[ -f "$SPECS" ] || { echo "missing $SPECS -- run rebuttal_infra/method3_18task_specs.py first"; exit 1; }

# SLURM_ARRAY_TASK_ID is 0-based; specs file is 1-based.
LINE_NO=$(( ${SLURM_ARRAY_TASK_ID:-0} + 1 ))
SPEC=$(sed -n "${LINE_NO}p" "$SPECS")
[ -n "$SPEC" ] || { echo "no spec on line $LINE_NO of $SPECS"; exit 1; }

echo "=== [array ${SLURM_ARRAY_TASK_ID}] line ${LINE_NO}: $SPEC ==="
# shellcheck disable=SC2086
"$PY" -m src.train.distill $SPEC
echo "=== done line ${LINE_NO} ==="

# ---------------------------------------------------------------------------
# DRY-RUN (validate the method pipeline before the 162-run sweep). Runs dkd / H3K9ac / seed 0 for
# ONE epoch: teacher-load (cache MISS at seed 0) -> teacher-logit precompute -> student train ->
# best-val ckpt -> test eval -> final_summary.json. Cheap; put it on ANY free node (NOT dependent):
#
#   srun --partition=zhanglab.p --gres=gpu:1 --cpus-per-task=5 --mem=64G --time=1:00:00 \
#     bash -c 'source slurm/env_setup.sh; \
#       .venv_carbon_portable/bin/python -m src.train.distill nt_vanilla --task-names H3K9ac \
#       --distillation-config.distill-method dkd --distillation-config.weight-ce 0.5 \
#       --distillation-config.weight-kl 1 --distillation-config.weight-mse 0 \
#       --distillation-config.temperature 2 --distillation-config.dkd-alpha 2.0 \
#       --distillation-config.dkd-beta 4.0 --trainer-config.epochs 1 \
#       --trainer-config.eval-every-n-epochs 1 --trainer-config.early-stop-patience 0 \
#       --trainer-config.output-dir /tmp/galaxy_srv_disk00/pengchx3/method3_18task_DRYRUN/dkd \
#       --random-state 0 --slurm-config.mode run'
# ---------------------------------------------------------------------------
